generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model Attendances {
  attendanceId String   @id @default(dbgenerated("gen_random_uuid()")) @map("attendance_id") @db.Uuid
  teacherId    String?  @map("teacher_id") @db.Uuid
  studentId    String?  @map("student_id") @db.Uuid
  classroomId  String   @map("classroom_id") @db.Uuid
  date         DateTime @db.Date
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  status       Status   @default(absent)

  createdBy String @map("created_by") @db.Uuid
  updatedBy String @map("updated_by") @db.Uuid

  createdByPerson People @relation("AttendancesCreatedBy", fields: [createdBy], references: [personId], onDelete: NoAction, onUpdate: NoAction)
  updatedByPerson People @relation("AttendancesUpdatedBy", fields: [updatedBy], references: [personId], onDelete: NoAction, onUpdate: NoAction)

  classrooms Classrooms @relation(fields: [classroomId], references: [classroomId], onDelete: NoAction, onUpdate: NoAction)
  students   Students?  @relation(fields: [studentId], references: [studentId], onDelete: NoAction, onUpdate: NoAction)
  teachers   Teachers?  @relation(fields: [teacherId], references: [teacherId], onDelete: NoAction, onUpdate: NoAction)

  @@index([date, classroomId], map: "idx_attendances_date_classroom_id")
  @@index([studentId], map: "idx_attendances_student_id")
  @@index([teacherId], map: "idx_attendances_teacher_id")
  @@map("attendances")
}

enum Status {
  present
  absent

  @@map("status")
}

model Classrooms {
  classroomId String   @id @default(dbgenerated("gen_random_uuid()")) @map("classroom_id") @db.Uuid
  classId     String   @map("class_id") @db.Uuid
  name        String   @unique @db.VarChar(50)
  description String?  @db.Text()
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  createdBy String @map("created_by") @db.Uuid
  updatedBy String @map("updated_by") @db.Uuid

  createdByPerson People @relation("ClassroomsCreatedBy", fields: [createdBy], references: [personId], onDelete: NoAction, onUpdate: NoAction)
  updatedByPerson People @relation("ClassroomsUpdatedBy", fields: [updatedBy], references: [personId], onDelete: NoAction, onUpdate: NoAction)

  attendances Attendances[]
  classes     Classes       @relation(fields: [classId], references: [classId], onDelete: NoAction, onUpdate: NoAction)
  schedules   Schedules[]
  students    Students[]

  @@unique([classId, name])
  @@index([classId], map: "idx_classrooms_level_id")
  @@map("classrooms")
}

model Classes {
  classId     String   @id @default(dbgenerated("gen_random_uuid()")) @map("class_id") @db.Uuid
  levelId     String   @map("level_id") @db.Uuid
  name        String   @unique @db.VarChar(50)
  description String?  @db.Text()
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  createdBy String @map("created_by") @db.Uuid
  updatedBy String @map("updated_by") @db.Uuid

  createdByPerson People @relation("ClassesCreatedBy", fields: [createdBy], references: [personId], onDelete: NoAction, onUpdate: NoAction)
  updatedByPerson People @relation("ClassesUpdatedBy", fields: [updatedBy], references: [personId], onDelete: NoAction, onUpdate: NoAction)

  levels     Levels       @relation(fields: [levelId], references: [levelId], onDelete: NoAction, onUpdate: NoAction)
  Classrooms Classrooms[]

  @@unique([levelId, name])
  @@index([levelId], map: "idx_classes_level_id")
  @@map("classes")
}

model Levels {
  levelId     String   @id @default(dbgenerated("gen_random_uuid()")) @map("level_id") @db.Uuid
  name        String   @unique @db.VarChar(50)
  description String?  @db.Text()
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  createdBy String @map("created_by") @db.Uuid
  updatedBy String @map("updated_by") @db.Uuid

  createdByPerson People @relation("LevelsCreatedBy", fields: [createdBy], references: [personId], onDelete: NoAction, onUpdate: NoAction)
  updatedByPerson People @relation("LevelsUpdatedBy", fields: [updatedBy], references: [personId], onDelete: NoAction, onUpdate: NoAction)

  classes Classes[]

  @@index([name], map: "idx_levels_name")
  @@map("levels")
}

enum Baptized {
  yes
  no

  @@map("baptized")
}

model People {
  personId     String   @id @default(dbgenerated("gen_random_uuid()")) @map("person_id") @db.Uuid
  name         String   @db.VarChar(100)
  personalCode String   @unique @map("personal_code") @db.VarChar(100)
  birthDate    DateTime @map("birth_date") @db.Date
  baptized     Baptized @default(no)
  profession   String?  @db.VarChar(100)
  phone        String?  @db.VarChar(20)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  // 🔹 Campos de relacionamento (chaves estrangeiras)
  createdBy String? @map("created_by") @db.Uuid
  updatedBy String? @map("updated_by") @db.Uuid

  // 🔹 Relações self-referenciais
  createdByPerson People? @relation("PeopleCreatedBy", fields: [createdBy], references: [personId], onDelete: NoAction, onUpdate: NoAction)
  updatedByPerson People? @relation("PeopleUpdatedBy", fields: [updatedBy], references: [personId], onDelete: NoAction, onUpdate: NoAction)

  students Students?
  teachers Teachers?
  users    Users?

  // 🔹 Relações inversas (quem este People criou/atualizou)
  createdPeople             People[]             @relation("PeopleCreatedBy")
  updatedPeople             People[]             @relation("PeopleUpdatedBy")
  createdClassrooms         Classrooms[]         @relation("ClassroomsCreatedBy")
  updatedClassrooms         Classrooms[]         @relation("ClassroomsUpdatedBy")
  createdClasses            Classes[]            @relation("ClassesCreatedBy")
  updatedClasses            Classes[]            @relation("ClassesUpdatedBy")
  createdLevels             Levels[]             @relation("LevelsCreatedBy")
  updatedLevels             Levels[]             @relation("LevelsUpdatedBy")
  createdSchedules          Schedules[]          @relation("SchedulesCreatedBy")
  updatedSchedules          Schedules[]          @relation("SchedulesUpdatedBy")
  createdAttendances        Attendances[]        @relation("AttendancesCreatedBy")
  updatedAttendances        Attendances[]        @relation("AttendancesUpdatedBy")
  createdTeacherEvaluations TeacherEvaluations[] @relation("TeacherEvaluationsCreatedBy")
  updatedTeacherEvaluations TeacherEvaluations[] @relation("TeacherEvaluationsUpdatedBy")
  createdTeachers           Teachers[]           @relation("TeachersCreatedBy")
  updatedTeachers           Teachers[]           @relation("TeachersUpdatedBy")
  createdUsers              Users[]              @relation("UsersCreatedBy")
  updatedUsers              Users[]              @relation("UsersUpdatedBy")
  createdStudents           Students[]           @relation("StudentsCreatedBy")
  updatedStudents           Students[]           @relation("StudentsUpdatedBy")

  @@index([personId], map: "idx_people_person_id")
  @@map("people")
}

model Schedules {
  scheduleId  String     @id @default(dbgenerated("gen_random_uuid()")) @map("schedule_id") @db.Uuid
  teacherId   String     @map("teacher_id") @db.Uuid
  classroomId String     @map("classroom_id") @db.Uuid
  startDate   DateTime   @db.Date
  endDate     DateTime   @db.Date
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime   @default(now()) @map("updated_at") @db.Timestamptz(6)
  Classrooms  Classrooms @relation(fields: [classroomId], references: [classroomId], onDelete: NoAction, onUpdate: NoAction)
  teachers    Teachers   @relation(fields: [teacherId], references: [teacherId], onDelete: NoAction, onUpdate: NoAction)

  createdBy String @map("created_by") @db.Uuid
  updatedBy String @map("updated_by") @db.Uuid

  createdByPerson People @relation("SchedulesCreatedBy", fields: [createdBy], references: [personId], onDelete: NoAction, onUpdate: NoAction)
  updatedByPerson People @relation("SchedulesUpdatedBy", fields: [updatedBy], references: [personId], onDelete: NoAction, onUpdate: NoAction)

  @@unique([classroomId, startDate, teacherId, endDate])
  @@index([startDate, endDate, classroomId], map: "idx_schedules_start_end_date_classroom_id")
  @@index([startDate, endDate, teacherId], map: "idx_schedules_start_end_date_teacher_id")
  @@map("schedules")
}

model Students {
  studentId   String   @id @default(dbgenerated("gen_random_uuid()")) @map("student_id") @db.Uuid
  accessKey   String   @unique(map: "idx_students_access_key") @map("access_key") @db.VarChar(100)
  personId    String   @unique @map("person_id") @db.Uuid
  classroomId String   @map("classroom_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  createdBy   String   @map("created_by") @db.Uuid
  updatedBy   String   @map("updated_by") @db.Uuid

  createdByPerson People     @relation("StudentsCreatedBy", fields: [createdBy], references: [personId], onDelete: NoAction, onUpdate: NoAction)
  updatedByPerson People     @relation("StudentsUpdatedBy", fields: [updatedBy], references: [personId], onDelete: NoAction, onUpdate: NoAction)
  Classrooms      Classrooms @relation(fields: [classroomId], references: [classroomId], onDelete: NoAction, onUpdate: NoAction)
  people          People     @relation(fields: [personId], references: [personId], onDelete: NoAction, onUpdate: NoAction)

  attendances Attendances[]

  @@index([classroomId], map: "idx_students_classroom_id")
  @@map("students")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model TeacherEvaluations {
  evaluationId String   @id @default(dbgenerated("gen_random_uuid()")) @map("evaluation_id") @db.Uuid
  teacherId    String   @map("teacher_id") @db.Uuid
  date         DateTime @db.Date
  score        Int
  comment      String?
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  createdBy String @map("created_by") @db.Uuid
  updatedBy String @map("updated_by") @db.Uuid

  createdByPerson People @relation("TeacherEvaluationsCreatedBy", fields: [createdBy], references: [personId], onDelete: NoAction, onUpdate: NoAction)
  updatedByPerson People @relation("TeacherEvaluationsUpdatedBy", fields: [updatedBy], references: [personId], onDelete: NoAction, onUpdate: NoAction)

  teachers Teachers @relation(fields: [teacherId], references: [teacherId], onDelete: NoAction, onUpdate: NoAction)

  @@index([teacherId, date], map: "idx_teacher_evaluations_teacher_id_date")
  @@map("teacher_evaluations")
}

model Teachers {
  teacherId    String   @id @default(dbgenerated("gen_random_uuid()")) @map("teacher_id") @db.Uuid
  personId     String   @unique @map("person_id") @db.Uuid
  userId       String?  @unique @map("user_id") @db.Uuid
  position     String   @db.VarChar(100)
  trainingYear DateTime @map("training_year") @db.Date
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  createdBy String @map("created_by") @db.Uuid
  updatedBy String @map("updated_by") @db.Uuid

  createdByPerson People @relation("TeachersCreatedBy", fields: [createdBy], references: [personId], onDelete: NoAction, onUpdate: NoAction)
  updatedByPerson People @relation("TeachersUpdatedBy", fields: [updatedBy], references: [personId], onDelete: NoAction, onUpdate: NoAction)

  attendances        Attendances[]
  schedules          Schedules[]
  teacherEvaluations TeacherEvaluations[]
  people             People               @relation(fields: [personId], references: [personId], onDelete: NoAction, onUpdate: NoAction)

  @@index([teacherId], map: "idx_teachers_teacher_id")
  @@map("teachers")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model Users {
  userId       String   @id @default(dbgenerated("gen_random_uuid()")) @map("user_id") @db.Uuid
  personId     String   @unique @map("person_id") @db.Uuid
  email        String   @unique @db.VarChar(255)
  passwordHash String   @map("password_hash") @db.VarChar(255)
  role         Role     @default(teacher)
  permissions  String[] @default([])
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  createdBy    String?  @map("created_by") @db.Uuid
  updatedBy    String?  @map("updated_by") @db.Uuid

  createdByPerson People? @relation("UsersCreatedBy", fields: [createdBy], references: [personId], onDelete: NoAction, onUpdate: NoAction)
  updatedByPerson People? @relation("UsersUpdatedBy", fields: [updatedBy], references: [personId], onDelete: NoAction, onUpdate: NoAction)

  people People @relation(fields: [personId], references: [personId], onDelete: NoAction, onUpdate: NoAction)

  @@index([userId], map: "idx_users_user_id")
  @@map("users")
}

enum Role {
  teacher
  student

  @@map("role")
}
